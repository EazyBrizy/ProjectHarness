{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SCHEMA-STAGE-STATE@1",
  "title": "Implementation Stage State",
  "type": "object",
  "required": [
    "schema_version",
    "implementation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "implementation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SCHEMA-STAGE-STATE-IMPLEMENTATION@1",
      "title": "Stage State Implementation",
      "type": "object",
      "required": [
        "scale_version",
        "target_level",
        "claimed_current_level",
        "observed_candidate_level",
        "highest_accepted_level",
        "active_stage",
        "progression_policy",
        "future_stage_work",
        "stage_path",
        "revision"
      ],
      "properties": {
        "scale_version": {
          "const": 1
        },
        "target_level": {
          "enum": [
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ]
        },
        "claimed_current_level": {
          "enum": [
            "NONE",
            "UNKNOWN",
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ]
        },
        "observed_candidate_level": {
          "enum": [
            "NONE",
            "UNKNOWN",
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ]
        },
        "highest_accepted_level": {
          "enum": [
            "NONE",
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ]
        },
        "active_stage": {
          "enum": [
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ]
        },
        "progression_policy": {
          "const": "SEQUENTIAL"
        },
        "future_stage_work": {
          "const": "FORBIDDEN"
        },
        "stage_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "PROTOTYPE",
              "ALPHA",
              "BETA",
              "MVP",
              "RELEASE"
            ]
          },
          "uniqueItems": true
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "permitted_use": {
          "type": [
            "object",
            "null"
          ]
        },
        "last_acceptance_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_assessment_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "level_up_decision_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
