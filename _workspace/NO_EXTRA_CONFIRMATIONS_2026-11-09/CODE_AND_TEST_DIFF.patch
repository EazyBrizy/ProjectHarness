+            p.locator('#lifecycle-apply').click()
+        p.wait_for_function('!state.requestBusy')
+        self.assertIs(captured[-1]['payload']['confirmed'],True)
+        self.assertEqual([r['action'] for r in captured],['verify','manual-evidence','level-up'])
+
