+    if status in {"WAITING_INPUT", "WAITING_DECISION", "BLOCKED", "TIMED_OUT", "FAILED_RETRYABLE"}:
+        return 3
+    if status in {"FAIL", "FAILED", "INVALID"}:
+        return 2
+    return 0
