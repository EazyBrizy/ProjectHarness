{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SCHEMA-MATURITY-ASSESSMENT@1",
  "title": "Brownfield Maturity Assessment",
  "type": "object",
  "required": [
    "maturity_assessment"
  ],
  "properties": {
    "maturity_assessment": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SCHEMA-MATURITY-ASSESSMENT-BODY@1",
      "title": "Maturity Assessment Body",
      "type": "object",
      "required": [
        "id",
        "revision",
        "repository_revision",
        "claimed_current_level",
        "observed_candidate_level",
        "highest_satisfied_candidate_level",
        "previous_highest_accepted_level",
        "proposed_active_stage",
        "target_level",
        "confidence",
        "criteria_results",
        "dimensions",
        "blocking_gaps",
        "recommended_route"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VAL-"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "repository_revision": {
          "type": "string",
          "minLength": 1
        },
        "base_tree_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimed_current_level": {
          "enum": [
            "NONE",
            "UNKNOWN",
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ]
        },
        "observed_candidate_level": {
          "enum": [
            "NONE",
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ]
        },
        "highest_satisfied_candidate_level": {
          "enum": [
            "NONE",
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ]
        },
        "previous_highest_accepted_level": {
          "enum": [
            "NONE",
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ]
        },
        "proposed_active_stage": {
          "enum": [
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ]
        },
        "target_level": {
          "enum": [
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ]
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "criteria_results": {
          "type": "object",
          "required": [
            "PROTOTYPE",
            "ALPHA",
            "BETA",
            "MVP",
            "RELEASE"
          ],
          "properties": {
            "PROTOTYPE": {
              "type": "array",
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "SCHEMA-STAGE-CRITERION-RESULT@1",
                "title": "Stage Criterion Result",
                "type": "object",
                "required": [
                  "criterion_ref",
                  "status",
                  "evidence_refs"
                ],
                "properties": {
                  "criterion_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "PASS",
                      "PARTIAL",
                      "FAIL",
                      "UNKNOWN",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rationale": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "validator": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "available_static_evidence_kinds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "ALPHA": {
              "type": "array",
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "SCHEMA-STAGE-CRITERION-RESULT@1",
                "title": "Stage Criterion Result",
                "type": "object",
                "required": [
                  "criterion_ref",
                  "status",
                  "evidence_refs"
                ],
                "properties": {
                  "criterion_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "PASS",
                      "PARTIAL",
                      "FAIL",
                      "UNKNOWN",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rationale": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "validator": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "available_static_evidence_kinds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "BETA": {
              "type": "array",
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "SCHEMA-STAGE-CRITERION-RESULT@1",
                "title": "Stage Criterion Result",
                "type": "object",
                "required": [
                  "criterion_ref",
                  "status",
                  "evidence_refs"
                ],
                "properties": {
                  "criterion_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "PASS",
                      "PARTIAL",
                      "FAIL",
                      "UNKNOWN",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rationale": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "validator": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "available_static_evidence_kinds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "MVP": {
              "type": "array",
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "SCHEMA-STAGE-CRITERION-RESULT@1",
                "title": "Stage Criterion Result",
                "type": "object",
                "required": [
                  "criterion_ref",
                  "status",
                  "evidence_refs"
                ],
                "properties": {
                  "criterion_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "PASS",
                      "PARTIAL",
                      "FAIL",
                      "UNKNOWN",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rationale": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "validator": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "available_static_evidence_kinds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "RELEASE": {
              "type": "array",
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "SCHEMA-STAGE-CRITERION-RESULT@1",
                "title": "Stage Criterion Result",
                "type": "object",
                "required": [
                  "criterion_ref",
                  "status",
                  "evidence_refs"
                ],
                "properties": {
                  "criterion_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "PASS",
                      "PARTIAL",
                      "FAIL",
                      "UNKNOWN",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rationale": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "validator": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "available_static_evidence_kinds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "NONE",
              "PROTOTYPE",
              "ALPHA",
              "BETA",
              "MVP",
              "RELEASE"
            ]
          }
        },
        "blocking_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_route": {
          "enum": [
            "COMPLETE_CURRENT_STAGE",
            "MAINTAIN_CURRENT_STAGE",
            "ADVANCE_TO_NEXT_STAGE",
            "TARGET_ALREADY_REACHED",
            "STABILIZE_CURRENT_STAGE"
          ]
        },
        "evidence_inventory": {
          "type": "array"
        },
        "automatic_command_execution": {
          "const": "FORBIDDEN"
        },
        "status": {
          "enum": [
            "COMPLETED",
            "STALE"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation_kind": {
          "enum": [
            "BROWNFIELD_BASELINE_FRESHNESS"
          ]
        },
        "source_assessment_ref": {
          "type": "string",
          "pattern": "^VAL-[A-Z0-9](?:[A-Z0-9._:-]*[A-Z0-9])?@[1-9][0-9]*$"
        },
        "source_assessment_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "staleness": {
          "type": "object",
          "required": [
            "detected_at",
            "reason_codes",
            "issues",
            "original_repository_revision",
            "detected_current_repository_revision",
            "assessment_context",
            "current_context"
          ],
          "properties": {
            "detected_at": {
              "type": "string",
              "minLength": 1
            },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "issues": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "field",
                  "message",
                  "actual",
                  "expected"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actual": {},
                  "expected": {}
                },
                "additionalProperties": false
              }
            },
            "original_repository_revision": {
              "type": "string",
              "minLength": 1
            },
            "detected_current_repository_revision": {
              "type": "string",
              "minLength": 1
            },
            "assessment_context": {
              "type": "object"
            },
            "current_context": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "validation_kind"
            ]
          },
          "then": {
            "required": [
              "status",
              "source_assessment_ref",
              "source_assessment_digest",
              "staleness"
            ],
            "properties": {
              "status": {
                "const": "STALE"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "source_assessment_ref"
                ]
              },
              {
                "required": [
                  "source_assessment_digest"
                ]
              },
              {
                "required": [
                  "staleness"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "validation_kind"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
