{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-harness:local-web:operation-receipt:1",
  "title": "Local Web operation receipt v1 (non-authoritative)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "receipt_version",
    "operation_id",
    "project_ref",
    "action_id",
    "idempotency_key",
    "request_sha256",
    "expected_core_fingerprint",
    "core_outcome",
    "created_at"
  ],
  "properties": {
    "kind": {
      "const": "LOCAL_WEB_OPERATION_RECEIPT"
    },
    "receipt_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^LWO-[A-Z0-9-]{6,72}$"
    },
    "project_ref": {
      "type": "string",
      "pattern": "^LWP-[A-Z0-9-]{4,72}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^LW-(?:C(?:0[1-9]|1[0-9]|2[0-6])|DRAFT)$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 160
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "expected_core_fingerprint": {
      "type": "string",
      "minLength": 10,
      "maxLength": 256
    },
    "core_outcome": {
      "enum": [
        "NOT_STARTED",
        "PENDING",
        "CONFIRMED_COMMITTED",
        "CONFIRMED_REJECTED",
        "UNKNOWN_RECONCILE"
      ]
    },
    "core_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "maxLength": 1024
    }
  }
}
