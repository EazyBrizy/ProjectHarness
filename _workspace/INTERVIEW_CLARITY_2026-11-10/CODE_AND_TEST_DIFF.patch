+
+    def screenshot(self,name):
+        target=os.environ.get('INTERVIEW_CLARITY_SCREENSHOTS')
+        if target:
+            Path(target).mkdir(parents=True,exist_ok=True)
+            self.page.screenshot(path=str(Path(target)/name),full_page=True)
+
