{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SCHEMA-SANDBOX-PROFILE@1",
  "type": "object",
  "required": [
    "sandbox_profile"
  ],
  "additionalProperties": false,
  "properties": {
    "sandbox_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "status",
        "backend",
        "image",
        "network_mode",
        "root_filesystem",
        "run_as_non_root",
        "drop_all_capabilities",
        "no_new_privileges",
        "writable_mounts",
        "limits"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SBX-[A-Z0-9][A-Z0-9-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "DRAFT",
            "VALIDATED",
            "ACTIVE",
            "SUSPENDED",
            "DEPRECATED",
            "RETIRED"
          ]
        },
        "backend": {
          "const": "ROOTLESS_PODMAN"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._/-]+(?:\\:[a-zA-Z0-9._-]+)?@sha256:[0-9a-f]{64}$"
        },
        "network_mode": {
          "enum": [
            "NONE",
            "EXPLICIT_APPROVED_EGRESS"
          ]
        },
        "root_filesystem": {
          "const": "READ_ONLY"
        },
        "run_as_non_root": {
          "const": true
        },
        "drop_all_capabilities": {
          "const": true
        },
        "no_new_privileges": {
          "const": true
        },
        "writable_mounts": {
          "const": [
            "/workspace/product",
            "/output",
            "/tmp"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeout_seconds",
            "memory_mb",
            "cpu_count",
            "pids",
            "output_bytes"
          ],
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 64,
              "maximum": 1048576
            },
            "cpu_count": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 256
            },
            "pids": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52428800
            }
          }
        }
      }
    }
  }
}
