  "$id": "SCHEMA-PROJECT-PREPARATION-INPUT@3",
  "title": "Project Harness PROJECT_INPUT v3",
  "description": "Strict browser-preparation contract for Project Harness v0.5.0, including user-confirmed implementation target.",
