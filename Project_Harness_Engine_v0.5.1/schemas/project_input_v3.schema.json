            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "project"
        ]
      },
      "then": {
        "properties": {
          "implementation": {
            "properties": {
              "claimed_current_level": {
                "const": "NONE"
              }
            },
            "required": [
              "claimed_current_level"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "project": {
            "properties": {
              "mode": {
                "enum": [
                  "BROWNFIELD",
                  "HYBRID"
                ]
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "project"
        ]
      },
      "then": {
        "properties": {
          "implementation": {
            "properties": {
              "claimed_current_level": {
                "enum": [
                  "UNKNOWN",
                  "PROTOTYPE",
                  "ALPHA",
                  "BETA",
                  "MVP",
                  "RELEASE"
                ]
              }
            },
            "required": [
              "claimed_current_level"
            ]
          },
          "approvals": {
            "required": [
              "brownfield_baseline"
            ]
          },
          "brownfield": {
            "properties": {
              "baseline_summary": {
